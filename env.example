# --- Symboles suivis ---
# Liste des paires à surveiller (séparées par des virgules)
SYMBOLS=XRPUSDT,SHIBUSDT,ETHUSDT,BTCUSDT,DOGEUSDT

# Nom lisible affiché dans les alertes pour chaque symbole
XRPUSDT=Ripple
SHIBUSDT=Shiba Inu
ETHUSDT=Ethereum
BTCUSDT=Bitcoin
DOGEUSDT=Dogecoin

# --- Historique ---
INTERVAL=1h
DAYS=14

# --- CORS ---
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# --- Cache & réseau ---
CACHE_TTL_SECONDS=20
HTTP_TIMEOUT_SECONDS=10
MAX_RETRIES=3
RETRY_BACKOFF_BASE=0.5

# --- Alertes Discord (bot, salon unique) ---
DISCORD_BOT_TOKEN=
DISCORD_ALERT_CHANNEL_ID=
ALERTS_SCHEDULER_TOKEN=
RSI_CHECK_INTERVAL_SECONDS=10
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70
